API_PORT=8000
CORS_ORIGINS=http://localhost:4200,https://ventrax-upc.github.io,http://localhost:5500
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_SIGN_IN_MAX=10
PROXY_TIMEOUT_MS=10000
# Required: same raw UTF-8 HMAC key as IAM. Supports HS256/HS384/HS512.
JWT_SECRET=replace-with-the-existing-iam-key
JWT_ISSUER=smartgn-iam-service
JWT_AUDIENCE=smartgn-api
# Host execution; integrated Docker overrides these with private service DNS.
IAM_URL=http://localhost:18080
INSTALLATION_URL=http://localhost:18081
SUPPORT_URL=http://localhost:8082
BILLING_URL=http://localhost:28083
