API_PORT=8000
CORS_ORIGINS=http://localhost:4200,https://ventrax-upc.github.io,http://localhost:5500
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_SIGN_IN_MAX=10
PROXY_TIMEOUT_MS=10000
# Required: same raw UTF-8 HMAC key as IAM. Supports HS256/HS384/HS512.
JWT_SECRET=replace-with-the-existing-iam-key
JWT_ISSUER=smartgn-iam-service
JWT_AUDIENCE=smartgn-api
INTERNAL_SERVICE_TOKEN=replace-with-the-shared-local-service-token
# Host execution; integrated Docker overrides these with private service DNS.
IAM_URL=http://localhost:8080
INSTALLATION_URL=http://localhost:8081
SUPPORT_URL=http://localhost:8082
BILLING_URL=http://localhost:8083
ALERTING_URL=http://localhost:8086
MONITORING_URL=http://localhost:8084
SMARTGN_CONFIG_URL=http://localhost:8088
SMARTGN_CONFIG_PROFILE=local
SMARTGN_ADMIN_URL=http://localhost:8089
SMARTGN_ADMIN_USERNAME=admin
SMARTGN_ADMIN_PASSWORD=change-this-for-local-only
