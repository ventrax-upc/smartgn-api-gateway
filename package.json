{
  "name": "smartgn-api-gateway",
  "version": "0.1.0",
  "description": "SmartGN API Gateway: routing, JWT perimeter validation, CORS and rate limiting",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "generate:openapi": "node tools/export-openapi.mjs",
    "verify": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22 <27"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "http-proxy-middleware": "^3.0.10",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-dist": "5.34.1"
  }
}
